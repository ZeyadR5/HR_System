# ==============================================================================
# إعدادات البيئة التجريبية (HR System - Demo Sandbox Environment)
# ==============================================================================
# يمكنك نسخ هذا الملف واستخدامه لتشغيل نسخة ديمو مستقلة على دومين فرعي (مثلاً demo.yourdomain.com)
# أو محلياً بربطه بقاعدة بيانات مستقلة مثل tk_demo

APP_NAME="HR System (Demo Sandbox)"
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost:8000

# تفعيل وضع الديمو (يُظهر الشريط العلوي ويتيح إعادة الضبط التلقائي بـ Cron Job)
DEMO_MODE=true

LOG_CHANNEL=stack
LOG_LEVEL=info

# قاعدة بيانات الديمو المنفصلة (يجب أن تكون مختلفة عن قاعدة بياناتك الحقيقية)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tk_demo
DB_USERNAME=root
DB_PASSWORD=C@!!me2unlock

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
